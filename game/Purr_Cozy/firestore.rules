rules_version = '2';

// 小窩時光：每位玩家一份存檔 saves/{userId}，備份在 saves/{userId}/backups/{backupId}。
// 只有登入的本人能讀寫；備份只能新增、不能修改；用過開發者模式的存檔（dev: true）不能被改回 false；
// 每次寫入的 rev 必須是上一次 +1，兩台裝置同時存檔時，慢的那一台會被拒絕，遊戲會讀回雲端存檔再自動合併。
// 好友、名片、拜訪、排行榜另外存在 profiles、codes、board、users/{uid}/friends、rooms（說明在各段上方）。
service cloud.firestore {
  match /databases/{database}/documents {

    // 後台（0.5.01）：管理者以上可以查看、列出所有存檔，也可以修改（rev 一樣要 +1，sync.admin 必須是自己的 Email，
    // 遊戲看到比自己新的管理者修改會直接採用雲端版本）；修改前先寫一份備份。刪除仍然只有本人。
    match /saves/{userId} {
      allow get: if isOwner(userId) || isManager();
      allow list: if isManager();
      allow create: if isOwner(userId) && validSave(request.resource.data)
        && request.resource.data.rev == 1;
      allow update: if isOwner(userId) && validSave(request.resource.data)
        && request.resource.data.rev == resource.data.get('rev', 0) + 1
        && (resource.data.get('dev', false) == false || request.resource.data.dev == true);
      allow update: if isManager() && validSave(request.resource.data)
        && request.resource.data.rev == resource.data.get('rev', 0) + 1
        && (resource.data.get('dev', false) == false || request.resource.data.dev == true)
        && request.resource.data.sync.get('admin', '') == myEmail();
      allow delete: if isOwner(userId);

      match /backups/{backupId} {
        allow get, list: if isOwner(userId) || isManager();
        allow create: if (isOwner(userId) || isManager()) && validBackup(request.resource.data);
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    // 玩家帳號登記（後台建立的帳號、測試帳號）：管理者以上管理；玩家本人可以讀自己那一份
    // （第一次登入遊戲時，遊戲用 seed 設定名字、金幣等初始內容）。密碼不會存在這裡。
    match /players/{userId} {
      allow get: if isOwner(userId) || isManager();
      allow list: if isManager();
      allow create: if isManager() && validPlayer(request.resource.data)
        && request.resource.data.createdBy == myEmail() && request.resource.data.createdAt == request.time;
      allow update: if isManager() && validPlayer(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isManager();
    }

    // ---------- 名片、好友、拜訪、排行榜 ----------
    // 名片：登入的人都能看單一份（不能列出全部），只能寫自己的
    match /profiles/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(userId) && validProfile(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // 好友代碼 → UID：只能用自己的 UID 建立，建立後不能修改
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 排行榜：一次最多讀 30 筆；每人只能寫自己的一列
    match /board/{userId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 30;
      allow create, update: if isOwner(userId) && validBoard(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // 好友名單：兩邊各存一份。s = out（我送出邀請）、in（對方邀請我）、ok（好友）
    match /users/{userId}/friends/{friendId} {
      allow get, list: if isOwner(userId);
      // 本人整理自己的名單：送出邀請（out）、接受邀請（in → ok）
      allow create: if isOwner(userId) && friendId != userId && validFriend(request.resource.data) && request.resource.data.s == 'out';
      allow update: if isOwner(userId) && resource.data.s == 'in' && request.resource.data.s == 'ok' && validFriend(request.resource.data);
      // 對方：送邀請時在我的名單留一筆 in；我接受時把對方名單裡的 out 改成 ok
      allow create: if isOwner(friendId) && friendId != userId && validFriend(request.resource.data) && request.resource.data.s == 'in';
      allow update: if isOwner(friendId) && resource.data.s == 'out' && request.resource.data.s == 'ok' && validFriend(request.resource.data);
      // 任何一方都能解除或拒絕
      allow delete: if isOwner(userId) || isOwner(friendId);
    }

    // 房間快照：本人和好友能看；幫忙紀錄只有好友能新增（每個需求一筆，先到先得），只有房間主人能讀和刪
    match /rooms/{userId} {
      allow get: if isOwner(userId) || isFriendOf(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && validRoom(request.resource.data);
      allow delete: if isOwner(userId);

      match /help/{helpId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isFriendOf(userId) && helpId.size() <= 64 && validHelp(request.resource.data) && request.resource.data.need == helpId;
        allow update: if false;
      }
    }

    // ---------- 團隊任務 ----------
    // 隊伍：登入的人都能讀（配對時一次最多查 20 隊）。可以做的更新只有這幾種：
    //   加入（隊伍開放配對，或你收到邀請；不能超過人數上限；還沒達成）、更新自己的進度（只能變多）、
    //   離開（還沒達成；離開後可以再加入別隊）、開關配對、達成時固定名單（roster = 當時的成員）
    //   換隊（接受邀請或配對時）是同一個交易裡「離開舊隊 + 加入新隊」，兩筆各自照上面的規則檢查
    match /teams/{teamId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create: if signedIn() && validTeam(request.resource.data)
        && request.resource.data.members == [request.auth.uid] && request.resource.data.by == request.auth.uid
        && request.resource.data.doneAt == 0 && request.resource.data.roster.size() == 0;
      allow update: if signedIn() && validTeam(request.resource.data) && sameTeam()
        && (teamJoin(teamId) || teamProgress() || teamLeave() || teamSettings() || teamComplete());
      allow delete: if false;

      // 領獎紀錄：每位完成名單上的成員一筆，只能建立一次（不會重複領）
      match /claims/{userId} {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.roster
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // 每個人這一期在哪一隊（登入的人可以查，邀請前用來確認好友還沒有隊伍）
    match /tm/{userId} {
      allow get: if signedIn();
      allow create, update: if isOwner(userId) && request.resource.data.keys().hasOnly(['d', 'w', 'at']) && request.resource.data.at == request.time;
      allow delete: if isOwner(userId);
    }

    // 團隊邀請：只有好友能寄給你；你可以看、可以刪；寄的人也可以收回
    // 同一隊再寄一次（或隊友也邀請了同一個人）會覆蓋舊的那一封，所以 create 和 update 用同一套檢查
    match /tinv/{userId}/list/{teamId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isFriendOf(userId) && inviteFromTeam(teamId)
        && request.resource.data.keys().hasOnly(['from', 'name', 'type', 'period', 'task', 'at'])
        && request.resource.data.from == request.auth.uid && shortText(request.resource.data.name, 40)
        && request.resource.data.type in ['d', 'w'] && shortText(request.resource.data.period, 16)
        && request.resource.data.at == request.time;
      allow delete: if isOwner(userId) || (signedIn() && resource.data.from == request.auth.uid);
    }

    // 同一個帳號只能在一台裝置登入：最後登入的裝置寫下自己的代號，其他裝置讀到不同的代號就會登出
    match /sess/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['sid', 'device', 'at'])
        && shortText(request.resource.data.sid, 40) && shortText(request.resource.data.device, 64)
        && request.resource.data.at == request.time;
      allow delete: if false;
    }

    // ---------- 學習紀錄（0.92.42）----------
    // 遊戲用「匿名帳號」寫入：每個回合一份 learnlog/{logId}/lsess/{sessionId}，只能新增、不能修改。
    // 0.92.46：程度測驗的回合多一個 pl（摘要，map）；名片 profiles 與排行榜 board 多一個 grade（玩家可關閉）。
    // 後台（tools/admin.html）：分析者以上可以讀全部紀錄；刪除只限管理者以上（例如玩家要求刪除資料時）。
    match /learnlog/{logId}/lsess/{sessionId} {
      allow create: if isOwner(logId) && validLearnLog(request.resource.data, logId, sessionId);
      allow get, list: if isOwner(logId) || isAnalyst();
      allow update: if false;
      allow delete: if isOwner(logId) || isManager();
    }
    // 分析頁面一次讀所有人的回合（collection group 查詢）
    match /{path=**}/lsess/{sessionId} {
      allow read: if isAnalyst();
    }

    // 0.92.48 使用行為：每人每天一份摘要 learnlog/{logId}/bday/{YYYY-MM-DD}（同一個匿名帳號寫入，一天只有幾次覆寫）
    match /learnlog/{logId}/bday/{day} {
      allow create, update: if isOwner(logId) && validDay(request.resource.data, logId, day);
      allow get, list: if isOwner(logId) || isAnalyst();
      allow delete: if isOwner(logId) || isManager();
    }
    match /{path=**}/bday/{day} {
      allow read: if isAnalyst();
    }

    // ---------- 後台帳號與權限 ----------
    // admins/{gmail}：最高管理者。只能在 Firebase 主控台新增或刪除（主控台不受規則限制），網頁不能改。
    // staff/{gmail}：在後台新增的帳號，角色 analyst（分析者）或 manager（管理者）。
    //   最高管理者可以新增、修改、刪除任何 staff；管理者只能管理「分析者」，不能動其他管理者，也不能改自己的權限。
    // adminlog：後台操作紀錄，只能新增、不能改刪；管理者以上可以查看。
    match /admins/{email} {
      allow get: if verified() && myEmail() == email;
      allow list: if isSuper();
      allow create, update, delete: if false;
    }

    match /staff/{email} {
      allow get: if verified() && (myEmail() == email || isManager());
      allow list: if isManager();
      allow create: if validStaff(email) && staffCreateStamp()
        && (isSuper() || (isManager() && request.resource.data.role == 'analyst'));
      allow update: if validStaff(email) && staffKeepsOrigin() && email != myEmail()
        && (isSuper() || (isManager() && resource.data.role == 'analyst' && request.resource.data.role == 'analyst'));
      allow delete: if email != myEmail() && (isSuper() || (isManager() && resource.data.role == 'analyst'));
    }

    match /adminlog/{logId} {
      allow create: if isAnalyst()
        && request.resource.data.keys().hasOnly(['by', 'role', 'act', 'target', 'detail', 'at'])
        && request.resource.data.by == myEmail()
        && shortText(request.resource.data.role, 16) && shortText(request.resource.data.act, 40)
        && shortText(request.resource.data.target, 120) && shortText(request.resource.data.detail, 400)
        && request.resource.data.at == request.time;
      allow get, list: if isManager();
      allow update, delete: if false;
    }

    // 其他所有路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ---------- 角色判斷 ----------
    // 最高管理者（super）＞ 管理者（manager）＞ 分析者（analyst）。上層角色擁有下層全部權限。
    // email_verified 一定要檢查：沒驗證的 Email 帳號可以填任何信箱，不檢查就能冒充。
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email is string;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isSuper() {
      return verified() && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }
    function staffRoleIn(roles) {
      return verified() && exists(/databases/$(database)/documents/staff/$(myEmail()))
        && get(/databases/$(database)/documents/staff/$(myEmail())).data.active == true
        && get(/databases/$(database)/documents/staff/$(myEmail())).data.role in roles;
    }
    function isManager() {
      return isSuper() || staffRoleIn(['manager']);
    }
    function isAnalyst() {
      return isSuper() || staffRoleIn(['manager', 'analyst']);
    }
    function validStaff(email) {
      let d = request.resource.data;
      return email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')
        && d.keys().hasOnly(['role', 'active', 'name', 'note', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.role in ['analyst', 'manager'] && d.active is bool
        && shortText(d.name, 40) && shortText(d.note, 200)
        && d.updatedBy == myEmail() && d.updatedAt == request.time;
    }
    function staffCreateStamp() {
      return request.resource.data.createdBy == myEmail() && request.resource.data.createdAt == request.time;
    }
    function staffKeepsOrigin() {
      return request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validPlayer(d) {
      return d.keys().hasOnly(['email', 'name', 'test', 'group', 'note', 'seed', 'disabled', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && shortText(d.email, 320) && shortText(d.name, 40) && d.test is bool
        && shortText(d.get('group', ''), 40) && shortText(d.get('note', ''), 200)
        && (!('seed' in d) || (d.seed is map && d.seed.size() <= 12))
        && d.get('disabled', false) is bool
        && shortText(d.createdBy, 320) && d.updatedBy == myEmail() && d.updatedAt == request.time;
    }

    function smallMap(m, n) {
      return m is map && m.size() <= n;
    }
    function validDay(d, logId, day) {
      return d.keys().hasOnly(['v', 'd', 'lid', 'acct', 'dev', 'app', 'tester', 'min', 'sess', 'h', 'win', 'wt', 'mini', 'fp', 'mus', 'songs',
                               'pet', 'furn', 'edit', 'focus', 'soc', 'first', 'last', 'at'])
        && d.v == 1 && d.lid == logId && d.d == day && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && shortText(d.acct, 128) && shortText(d.dev, 40) && shortText(d.app, 16) && d.tester is bool
        && d.min is number && d.min <= 1440 && d.sess is int && d.sess <= 500
        && smallMap(d.h, 24) && smallMap(d.win, 41) && smallMap(d.wt, 41) && smallMap(d.mini, 41) && smallMap(d.fp, 41)
        && smallMap(d.pet, 41) && smallMap(d.furn, 41) && smallMap(d.soc, 41)
        && d.mus is number && d.songs is int && d.edit is number && d.focus is number
        && shortText(d.first, 5) && shortText(d.last, 5)
        && d.at == request.time;
    }

    function validLearnLog(d, logId, sessionId) {
      return d.keys().hasOnly(['v', 'id', 'lid', 'acct', 'dev', 'app', 'lang', 'kind', 'sub', 't0', 't1', 'dur', 'done', 'stop',
                               'n', 'right', 'coins', 'xp', 'streak', 'lv', 'ans', 'rev', 'typo', 'pl', 'at'])
        && d.v == 1 && d.id == sessionId && d.lid == logId
        && (!('pl' in d) || (d.pl is map && d.pl.size() <= 12))
        && d.kind is string && d.kind.size() <= 16
        && d.sub is string && d.sub.size() <= 40
        && d.t0 is int && d.t1 is int && d.dur is int
        && d.ans is list && d.ans.size() <= 300
        && d.rev is list && d.rev.size() <= 300
        && d.typo is list && d.typo.size() <= 100
        && d.acct is string && d.acct.size() <= 128
        && d.at == request.time;
    }

    function signedIn() {
      return request.auth != null;
    }

    // 房間主人的好友名單裡有我，而且狀態是 ok（一定經過房間主人同意）
    function isFriendOf(userId) {
      return signedIn() && request.auth.uid != userId
        && exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)).data.s == 'ok';
    }

    function shortText(t, n) {
      return t is string && t.size() <= n;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'code', 'status', 'ava', 'lvl', 'pets', 'wk', 'wm', 'tm', 'room', 'dev', 'grade', 'at'])
        && shortText(d.name, 40) && d.name.size() >= 1
        && (!('grade' in d) || shortText(d.grade, 12))
        && shortText(d.code, 8) && shortText(d.status, 60) && shortText(d.wk, 16)
        && d.ava is map && d.pets is list && d.pets.size() <= 10
        && d.lvl is int && d.wm is int && d.tm is int && d.dev is bool
        && d.room is string && d.room.size() < 120000
        && d.at == request.time;
    }

    function validBoard(d) {
      return d.keys().hasOnly(['name', 'ava', 'lvl', 'lv', 'coins', 'tm', 'w', 'dev', 'grade', 'at'])
        && d.get('dev', false) is bool
        && (!('grade' in d) || shortText(d.grade, 12))
        && shortText(d.name, 40) && d.ava is map
        && d.lvl is int && d.lv is int && d.coins is int && d.coins >= 0 && d.tm is int
        && d.w is map && d.w.size() <= 1
        && d.at == request.time;
    }

    function validFriend(d) {
      return d.keys().hasOnly(['s', 'name', 'at'])
        && d.s in ['out', 'in', 'ok'] && shortText(d.name, 40)
        && d.at == request.time;
    }

    function validRoom(d) {
      return d.keys().hasOnly(['name', 'data', 'at'])
        && shortText(d.name, 40) && d.data is string && d.data.size() < 400000
        && d.at == request.time;
    }

    function validHelp(d) {
      return d.keys().hasOnly(['from', 'name', 'kind', 'need', 'target', 'tname', 'day', 'at'])
        && d.from == request.auth.uid
        && d.kind in ['feed', 'water', 'dust']
        && shortText(d.name, 40) && shortText(d.need, 64) && shortText(d.target, 32) && shortText(d.tname, 60) && shortText(d.day, 16)
        && d.at == request.time;
    }

    function validTeam(d) {
      return d.keys().hasOnly(['type', 'period', 'task', 'goal', 'max', 'members', 'names', 'prog', 'open', 'full', 'mAt', 'doneAt', 'roster', 'by', 'at'])
        && d.get('mAt', 0) is int
        && d.type in ['d', 'w'] && shortText(d.period, 16) && d.task in ['focus', 'quiz', 'care', 'eng']
        && d.goal is int && d.max is int && d.max >= 1 && d.max <= 5
        && d.members is list && d.members.size() <= d.max
        && d.names is map && d.prog is map && d.open is bool && d.full is bool
        && d.roster is list && d.by is string
        && d.at == request.time;
    }

    // 隊伍的任務內容、人數上限、建立者都不能改
    function sameTeam() {
      return request.resource.data.type == resource.data.type && request.resource.data.period == resource.data.period
        && request.resource.data.task == resource.data.task && request.resource.data.goal == resource.data.goal
        && request.resource.data.max == resource.data.max && request.resource.data.by == resource.data.by;
    }

    function teamChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // 邀請只能由隊伍裡的人寄出，而且是這一期、還沒完成的隊伍
    function inviteFromTeam(teamId) {
      let t = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return request.auth.uid in t.members && t.doneAt == 0
        && t.type == request.resource.data.type && t.period == request.resource.data.period;
    }

    // 隊員貢獻加總（隊伍最多 5 人；只算目前名單上的人）
    function seat(d, i) {
      return d.members.size() > i ? d.prog.get(d.members[i], 0) : 0;
    }
    function teamTotal(d) {
      return seat(d, 0) + seat(d, 1) + seat(d, 2) + seat(d, 3) + seat(d, 4);
    }

    function teamJoin(teamId) {
      return !(request.auth.uid in resource.data.members) && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.size() <= resource.data.max
        && resource.data.doneAt == 0
        && (resource.data.open == true || exists(/databases/$(database)/documents/tinv/$(request.auth.uid)/list/$(teamId)))
        && teamChanged().hasOnly(['members', 'names', 'prog', 'full', 'at'])
        && request.resource.data.prog.diff(resource.data.prog).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.prog[request.auth.uid] == 0;
    }

    function teamProgress() {
      return request.auth.uid in resource.data.members
        && teamChanged().hasOnly(['prog', 'at'])
        && request.resource.data.prog.diff(resource.data.prog).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.prog[request.auth.uid] is int
        && request.resource.data.prog[request.auth.uid] >= resource.data.prog.get(request.auth.uid, 0);
    }

    function teamLeave() {
      return request.auth.uid in resource.data.members && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && resource.data.doneAt == 0
        && teamChanged().hasOnly(['members', 'names', 'prog', 'full', 'open', 'at'])
        // 只能帶走自己的那一筆：自己的貢獻和名字刪掉，別人的不能動
        && request.resource.data.prog.diff(resource.data.prog).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && !(request.auth.uid in request.resource.data.prog) && !(request.auth.uid in request.resource.data.names)
        && request.resource.data.full == false
        && (request.resource.data.open == resource.data.open || request.resource.data.members.size() == 0);
    }

    // 開關配對；倒數（mAt）只能歸零（立即配對、自動配對、不要自動配對），不能延長
    function teamSettings() {
      return request.auth.uid in resource.data.members && resource.data.doneAt == 0 && teamChanged().hasOnly(['open', 'mAt', 'at'])
        && (request.resource.data.get('mAt', 0) == 0 || request.resource.data.get('mAt', 0) == resource.data.get('mAt', 0));
    }

    function teamComplete() {
      return request.auth.uid in resource.data.members && resource.data.doneAt == 0
        && request.resource.data.doneAt == request.time
        && request.resource.data.roster == resource.data.members
        && teamTotal(resource.data) >= resource.data.goal
        && teamChanged().hasOnly(['doneAt', 'roster', 'open', 'full', 'at']);
    }

    function validSave(d) {
      return d.keys().hasOnly(['v', 'schema', 'rev', 'savedAt', 'device', 'lvl', 'coins', 'email', 'dev', 'sync', 'data', 'updated'])
        && d.v == 1
        && d.schema is int && d.schema >= 1
        && d.rev is int
        && d.data is string && d.data.size() < 900000
        && d.savedAt is int
        && d.device is string && d.device.size() < 64
        && d.lvl is int && d.coins is int
        && d.email is string && d.email.size() < 320
        && d.dev is bool
        && d.sync is map
        && d.updated == request.time;
    }

    function validBackup(d) {
      return d.keys().hasOnly(['v', 'at', 'reason', 'device', 'savedAt', 'lvl', 'coins', 'data', 'updated'])
        && d.v == 1
        && d.data is string && d.data.size() < 900000
        && d.reason is string && d.reason.size() < 200
        && d.at is int && d.savedAt is int
        && d.updated == request.time;
    }
  }
}
