 original:null,
};
UI.WIN.furnplay={t:I18n.s('fp_title'),i:'i_sparkle',w:480,at:['c',0]};UI.w_furnplay=()=>FurnPlay.render();
(function(){const previous=Game.interact.bind(Game);FurnPlay.original=previous;Game.interact=function(it){const d=ITEMS[it.k],p=d?.interactionProfile;if(!d||Room.edit||Room.state!==Game.S||!p||p==='native'||d.toggle||d.tv||d.clock||d.seat||d.chair||d.bed||d.desk||['laptop','monitor','dual_monitor'].includes(d.spr))return previous(it);const need=Life.needOf('item',it.uid);if(need&&NEED_DEFS[need.type]?.item)return previous(it);if(p.startsWith('direct_'))return UI.openWin(p.slice(7));if(p==='typing')return CatsTypo.open();if(p==='memo')return UI.openWin('memo');UI.clearBubbles('furniture');it.shake=.2;FurnPlay.open(it,p)};
 const close=UI.closeWin.bind(UI);UI.closeWin=function(id){if(id==='furnplay')FurnPlay.close();return close(id)};
 const open=UI.openWin.bind(UI);UI.openWin=function(id){if(id!=='furnplay'&&FurnPlay.session)UI.closeWin('furnplay');return open(id)};
 const load=Game.load.bind(Game);Game.load=function(){if(FurnPlay.session)UI.closeWin('furnplay');return load(...arguments)};
 document.addEventListener('visibilitychange',()=>{if(document.hidden&&FurnPlay.session){FurnPlay.stopRound();const s=FurnPlay.session;if(['wait','ready','listen','input','play','brewing','breathing'].includes(s.phase)){s.phase='idle';s.cards=null;s.puzzle=null;s.weave=null;s.status=FurnPlay.t('paused');FurnPlay.refresh()}}});
 document.addEventListener('keydown',e=>{if(e.isComposing||e.ctrlKey||e.metaKey||e.altKey||!FurnPlay.visible()||/INPUT|TEXTAREA|SELECT/.test(e.target.tagName))return;const s=FurnPlay.session;if(['reaction','balance'].includes(s.profile)&&e.code==='Space'&&e.target.tagName!=='BUTTON'){e.preventDefault();if(!e.repeat)(s.profile==='reaction'?FurnPlay.react():s.phase==='play'?FurnPlay.stack():FurnPlay.balanceStart())}});
})();
/* 0.92.42 Purr Cozy: anonymous learning log.
   Records only learning behaviour: review cards, quiz answers (every learning entry: daily, practice, room needs,
   pet training, helping friends, story, team, challenges, level gates) and Meow Typo spelling.
   Nothing about furniture, pets, chat or the player's name / e-mail is recorded.

   - One document per learning session: learnlog/{logId}/lsess/{sessionId}
     logId is an anonymous Firebase account that exists only for this log (a second Firebase app instance),
     so it never touches the player's real login or cloud save. acct = the real account UID when signed in.
   - Sessions are queued in localStorage and uploaded in batches (finish, every 30 s, next launch), so nothing is
     lost offline and there is only one write per session.
   - Players can turn it off in Settings ("Share anonymous learning data"); the queue is then discarded.
   Field reference: docs/Â≠∏ÁøíÁ¥ÄÈåÑËàáÂàÜÊûê-Ë®≠ÂÆöÊïôÂ≠∏.md (section "Ë≥áÊñôÊ¨Ñ‰Ωç").
