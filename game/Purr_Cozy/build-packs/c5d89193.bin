 render_plant(){const r=this.record(),today=Life.today();return[h('p',{class:'fp-stat',text:this.t('careDays',[r.careDays||0])}),this.button(r.careDay===today?'cared':'care',()=>{const s=this.session;if(this.record().careDay===Life.today())return;const need=Life.needOf('item',s.it.uid);if(need){this.native();return}Fun.water(s.it,ITEMS[s.it.k],s.it.x+Room.itemCanvas(s.it).width/2);this.write({careDay:Life.today(),careDays:(this.record().careDays||0)+1});s.status=this.t('careDone');this.refresh()},r.careDay===today,'primary'),h('p',{class:'hint',text:this.t('careHelp')})]},
 render_brew(){const s=this.session,food=/cake|candy|macaron|donut|fruit|cookie|icecream/.test(s.it.k);return[h('p',{class:'fp-brew-state',role:'status',text:this.t(s.phase==='brewing'?(food?'plating':'brewing'):s.phase==='ready'?'brewReady':(food?'dessertHelp':'brewHelp'))}),h('progress',{class:'fp-progress',max:8,value:s.phase==='ready'?8:0,'aria-label':this.t('brewing')}),this.button(s.phase==='ready'?'enjoy':(food?'dessertPrep':'brewStart'),()=>s.phase==='ready'?this.enjoy():this.brew(),s.phase==='brewing','primary'),h('p',{class:'hint',text:this.t('brewCount',[this.record().cups||0])})]},
