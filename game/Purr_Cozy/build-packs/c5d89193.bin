 enjoy(){if(!this.valid()||this.session.phase!=='ready')return;const s=this.session;this.write({cups:(this.record().cups||0)+1});if(ITEMS[s.it.k].act==='brew'){this.native();return}s.phase='idle';s.status=this.t('enjoyed');Room.puff('p_steam',s.it.x+Room.itemCanvas(s.it).width/2,s.it.y-2,{vy:-6,max:1.4});this.refresh()},
 render_breath(){const s=this.session;return[h('div',{class:'fp-breath'+(s.phase==='breathing'?' running':'')},h('span',{class:'fp-breath-label',text:this.t('breathReady')})),h('progress',{class:'fp-progress',max:30,value:0,'aria-label':this.t('breathTime')}),this.button(s.phase==='breathing'?'stop':'breathStart',()=>{if(s.phase==='breathing'){this.stopRound();s.phase='idle';this.refresh()}else this.breathe()},false,'primary'),h('p',{class:'hint',text:this.t('breathHelp')})]},
 breathe(){this.stopRound();const s=this.session;s.phase='breathing';s.began=Date.now();s.status='';this.refresh();const tick=()=>{const sec=(Date.now()-s.began)/1000,el=UI.wins.furnplay.body.querySelector('.fp-breath-label'),bar=UI.wins.furnplay.body.querySelector('.fp-progress');if(el)el.textContent=I18n.render(this.t(sec%10<4?'inhale':'exhale'));if(bar)bar.value=Math.min(30,sec);if(sec>=30){s.phase='idle';this.write({breaths:(this.record().breaths||0)+1});s.status=this.t('breathDone');this.refresh()}else this.later(tick,250)};tick()},
 render_study(){return[h('div',{class:'fp-actions'},this.button('learn',()=>this.launch('learn'),false,'primary'),this.button('typing',()=>this.launch('catstypo')),this.button('focus',()=>this.launch('timer')),this.button('todos',()=>this.launch('todo')))]},
