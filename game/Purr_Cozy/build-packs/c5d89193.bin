const NOOK_YT = { id: 'yt_nook', type: 'yt', list: 'PL_77ETNrRb7Ep0Zv3tQNLNxQgwTsTHNrV', title: I18n.s("u_b98b2b8dc092"), builtin: true };

const MusicDefault = {
