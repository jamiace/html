éQ‰µ∆4@µPsƒñ†Ñß{(rj(Ú⁄bq@µ^:O: ûÓ°•É^™?–•åÆΩoq@Ò<ÊÿÄ™~Ï∫¨Û≈e)uü4@±)„X ÿπﬁ7–πŒ~ƒ®I@bËÃ≤7H–6 DπÁó4}ÕñÒÜ÷WLê␀Aâ˛f xA10«(Úπq␀4˜Ç≠ı˘?ä‚˜	@␀␀␀ˇˇ¿xπ␀␀␀IDAT␀:≈î␀ö␀␀␀␀IENDÆB`Ç@font-face{font-family:"Purr Cozy Japanese";src:url("../assets/fonts/purr-ja.woff2") format("woff2");font-display:swap;font-weight:100 900}
/* Locale-specific fonts and flexible settings controls. */
html:lang(ja){--font:"Purr Cozy Japanese","Noto Sans JP","Yu Gothic","Hiragino Kaku Gothic ProN","Meiryo",system-ui,sans-serif;--pix:"Silkscreen","Purr Cozy Japanese","Noto Sans JP","Yu Gothic","Meiryo",monospace}
html:lang(zh-CN){--font:"Noto Sans SC","PingFang SC","Microsoft YaHei",system-ui,sans-serif;--pix:"Silkscreen","Noto Sans SC","Microsoft YaHei",monospace}
.language-settings{padding:12px;display:flex;flex-direction:column;gap:10px;min-width:0}
.language-settings label{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.language-settings select{font:inherit;min-height:38px;min-width:150px;max-width:100%;padding:5px 9px;background:var(--well);color:var(--well-ink);border:1px solid var(--line);border-radius:5px}
.language-settings .chip{white-space:normal;min-height:40px;height:auto;line-height:1.5}
html:lang(ja) .win-h h2{overflow-wrap:anywhere;line-height:1.4}
html:lang(ja) .tm-mode,html:lang(ja) .mt-mode{white-space:normal;word-break:normal;overflow-wrap:anywhere}
@media(max-width:759px){html:lang(ja) .dock .label{font-size:10px}.language-settings{padding:10px}.language-settings select{flex:1}}
html:lang(ja) .ct-actions .ct-key{font-family:var(--font)}
html:lang(ja) .ct-top h3{line-height:1.35}
html:lang(ja) .ct-notice{max-height:3em;overflow:auto}
@media(max-width:350px){html:lang(ja) .ct-top h3{font-size:14px}html:lang(ja) .win[data-id="catstypo"] .win-h h2{font-size:14px}}

@media(max-width:350px) and (max-height:550px){html:lang(ja) .ct-notice{font-size:11px;line-height:1.3;max-height:28.6px}html:lang(ja) .ct-spelling-hint{margin:1px 0}html:lang(ja) .ct-question{padding:3px 9px}}

/* 0.92.9: reserve usable height and let translated labels wrap. */
.win-b>button.chip,.win-b>.row,.win-b>.tabs,.win-b>p,.win-b>.field{flex-shrink:0}
.win-b>button.chip{min-height:36px;height:auto;white-space:normal;line-height:1.5}
.win-b .chip:not(.icon-only){min-height:32px;height:auto;white-space:normal;line-height:1.4;overflow-wrap:anywhere}
.win-b .tab{min-height:34px;height:auto;white-space:normal;line-height:1.4;flex-shrink:0}
.cfoot{flex-wrap:wrap;gap:7px}.cfoot .price{flex:none}.cfoot .chip{flex-shrink:0}.lock{font-size:12px;white-space:normal;line-height:1.4}
.dock-btn{width:78px;min-width:78px;min-height:76px;height:auto;white-space:normal;flex-shrink:0}
.dock-btn>span{display:block;max-width:100%;min-height:32px;line-height:1.25;text-align:center;overflow-wrap:anywhere;white-space:normal}
.win[data-id="timer"] .win-b{display:flex;flex-direction:column;gap:10px;max-height:min(80dvh,800px);overflow:auto}
.win[data-id="timer"] .win-b>*{flex:0 0 auto}
.win[data-id="timer"] .big-time{display:block;min-height:72px;font-size:64px;line-height:1.1}
.win[data-id="timer"] .seg{height:12px;min-height:12px}
.win[data-id="timer"] .rounds{min-height:22px}
.win[data-id="timer"] .tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}
.win[data-id="timer"] .tabs .tab{padding:4px;font-size:13px;justify-content:center}
.ct-banner{display:grid!important;grid-template-columns:66px minmax(0,1fr) auto;align-items:center;gap:10px;width:100%;min-height:108px;max-height:150px;padding:12px!important;box-sizing:border-box}
.ct-banner img{width:66px;height:64px}.ct-banner-copy{width:100%;min-width:0;overflow-wrap:normal;word-break:normal}
.ct-banner-copy strong{font-size:25px;white-space:nowrap}.ct-banner-copy>span{font-size:13px;line-height:1.4}
.ct-banner-copy small{font-size:10px;line-height:1.4;max-width:none}.ct-banner-go{position:static!important;margin:0;padding:6px 8px;font-size:11px;white-space:nowrap}
.win[data-id="timer"] .ct-banner{grid-template-columns:54px minmax(0,1fr) auto;min-height:90px;max-height:120px;gap:7px}
.win[data-id="timer"] .ct-banner img{width:54px;height:55px}
.win[data-id="timer"] .ct-banner-copy strong{font-size:22px}
.win[data-id="timer"] .ct-banner-copy small{display:none}
.pin{box-sizing:border-box;min-width:160px;min-height:110px}
.pin .pin-grip{flex:0 0 27px;box-sizing:border-box}
.pin textarea{width:100%;height:100%;flex:1 1 auto;min-height:0;min-width:0;box-sizing:border-box;resize:none;padding-bottom:16px}
.pin-resize{position:absolute;border:0;background:transparent;box-shadow:none;padding:0;min-height:0;touch-action:none;color:#8a6a47}
.pin-resize-x{right:0;top:28px;bottom:15px;width:10px;cursor:ew-resize}
.pin-resize-y{bottom:0;left:10px;right:17px;height:10px;cursor:ns-resize}
.pin-resize-xy{right:0;bottom:0;width:18px;height:18px;font-size:15px;line-height:18px;cursor:nwse-resize}
@media(max-width:759px){
 .win-b .chip:not(.icon-only){min-height:38px}.win-b .tab{min-height:38px}
 .win[data-id="timer"] .win-b{max-height:none}.ct-banner{grid-template-columns:55px minmax(0,1fr) auto;gap:7px;min-height:104px}
 .ct-banner img{width:55px;height:55px}.ct-banner-copy strong{font-size:23px}.ct-banner-go{font-size:10px;padding:6px}
}
@media(max-width:350px){.ct-banner{grid-template-columns:46px minmax(0,1fr);gap:7px}.ct-banner-go{grid-column:2;justify-self:start;margin-top:2px}.ct-banner img{grid-row:1/3;width:46px}.ct-banner-copy small{display:none}}

.ct-banner-copy>span{text-wrap:balance}
@media(max-width:759px){
 .win[data-id="timer"]{top:calc(var(--purr-top,0px) + env(safe-area-inset-top,0px) + 8px)!important;bottom:auto!important;max-height:calc(var(--purr-vh,100dvh) - var(--mobile-nav-height,60px) - 16px)}
 .win[data-id="timer"] .win-b{max-height:calc(var(--purr-vh,100dvh) - var(--mobile-nav-height,60px) - 82px)!important;gap:6px}
 .win[data-id="timer"] .big-time{font-size:48px;min-height:54px}.win[data-id="timer"] .rounds{min-height:16px}
}

/* Fixed letter slots remain visible after typing on desktop and mobile. */
.spell-slots{display:flex;flex:0 0 auto;flex-wrap:wrap;justify-content:center;align-items:end;gap:4px 5px;padding:7px 0 9px;min-width:0;max-width:100%}
.spell-letter{display:inline-flex;align-items:center;justify-content:center;flex:0 0 20px;height:29px;box-sizing:border-box;border-bottom:2px solid var(--ink);font:20px/1.2 var(--font);color:var(--ink);text-transform:lowercase}
.spell-letter.hinted{color:var(--ink-2)}
body.purr-quiz-open .quiz-input{display:flex;flex-direction:column;gap:4px}
body.purr-quiz-open .quiz-input .spell-slots{padding:3px 0 7px;gap:3px 4px}
body.purr-quiz-open .spell-letter{flex-basis:18px;height:25px;font-size:18px}
body.purr-quiz-open .quiz-shell.answered .quiz-input{display:none}

/* Keep all Meow Typo entry text readable, including the timer entry. */
.ct-banner,.win[data-id="timer"] .ct-banner{display:flex!important;flex-wrap:wrap;gap:10px;min-height:116px;max-height:none;padding:12px!important}
.ct-banner img,.win[data-id="timer"] .ct-banner img{width:66px;height:64px}
.ct-banner-copy{flex:1;min-width:140px;width:auto;gap:4px}
.ct-banner-copy strong,.win[data-id="timer"] .ct-banner-copy strong{font-size:26px;line-height:1.15;white-space:normal}
.ct-banner-copy>span{font-size:15px;line-height:1.4}
.ct-banner-copy small,.win[data-id="timer"] .ct-banner-copy small{display:block;font-size:14px;line-height:1.45;max-width:none}
.ct-banner-go{position:static!important;margin-left:auto;font-size:14px;min-height:36px;padding:8px 12px}
@media(max-width:350px){.ct-banner img,.win[data-id="timer"] .ct-banner img{width:52px;height:56px}.ct-banner-copy small{display:block}.ct-banner-copy strong,.win[data-id="timer"] .ct-banner-copy strong{font-size:24px}}

.spell-separator{align-self:center;font-size:18px;color:var(--ink)}

/* Inactive actions are gray in both themes; preserve quiz result option colors. */
button.chip:disabled,button.swapbtn:disabled,button.tab:disabled,button.mtab:disabled,
button.ct-btn:disabled,button.ct-key:disabled,button.xbtn:disabled{
 filter:grayscale(1)!important;opacity:.65!important;cursor:not-allowed!important;
 background:#d3d0cc!important;color:#585552!important;text-shadow:none!important;
 transform:none!important;box-shadow:none!important
}
button.chip:disabled:active,button.tab:disabled:active{border-image-source:var(--f-btn)}
