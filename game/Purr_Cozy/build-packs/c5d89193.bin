 react(){if(!this.visible())return;const s=this.session;if(s.phase==='wait'){this.stopRound();s.phase='lost';s.status=this.t('tooSoon');this.refresh();return}if(s.phase==='ready'){const ms=Math.round(performance.now()-s.readyAt);s.phase='won';s.status=this.t('reactionResult',[ms]);this.best('reactionBest',ms,true);this.refresh();return}this.stopRound();s.phase='wait';s.status='';this.refresh();this.later(()=>{s.phase='ready';s.readyAt=performance.now();this.refresh()},1200+Math.random()*2200)},
 newCards(){if(!this.valid())return;this.stopRound();const s=this.session,d=ITEMS[s.it.k],pool=Object.keys(ITEMS).filter(k=>k!==s.it.k&&ITEMS[k].fam===d.fam),fallback=Object.keys(ITEMS).filter(k=>ITEMS[k].interactionProfile==='memory');const choices=[s.it.k,...this.shuffle(pool.length>=3?pool:fallback).filter(k=>k!==s.it.k).slice(0,3)];s.cards=this.shuffle(choices.flatMap((k,i)=>[{k,pair:i},{k,pair:i}]));s.flipped=[];s.matched=[];s.moves=0;s.phase='play';s.status='';this.refresh()},
