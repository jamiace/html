 slide(i){if(!this.visible())return;const s=this.session;if(!s.puzzle||s.phase==='won')return;const z=s.puzzle.indexOf(0);if(Math.abs(i%3-z%3)+Math.abs(Math.floor(i/3)-Math.floor(z/3))!==1)return;[s.puzzle[z],s.puzzle[i]]=[s.puzzle[i],s.puzzle[z]];s.moves++;if(s.puzzle.every((v,i)=>v===(i+1)%9)){s.phase='won';this.best('puzzleBest',s.moves,true);s.status=this.t('puzzleWin',[s.moves])}this.refresh()},
 balanceStart(){this.stopRound();const s=this.session;s.phase='play';s.level=0;s.width=80;s.baseX=10;s.position=0;s.started=performance.now();s.status='';this.refresh();this.animateBalance()},
 animateBalance(){if(!this.visible()||this.session.phase!=='play')return;const s=this.session;s.position=(Math.sin((performance.now()-s.started)/650*(1+s.level*.13))+1)/2*(100-s.width);const el=UI.wins.furnplay.body.querySelector('.fp-moving');if(el){el.style.left=s.position+'%';el.style.width=s.width+'%'}this.raf=requestAnimationFrame(()=>this.animateBalance())},
 render_balance(){const s=this.session;return[h('p',{class:'hint',text:this.t('balanceHelp',[s.level||0])}),h('div',{class:'fp-balance'},h('div',{class:'fp-base',style:`left:${s.baseX??10}%;width:${s.width??80}%`}),h('div',{class:'fp-moving',style:`left:${s.position||0}%;width:${s.width??80}%`})),this.button(s.phase==='play'?'stack':'start',()=>s.phase==='play'?this.stack():this.balanceStart(),false,'primary fp-big'),h('p',{class:'hint',text:this.t('balanceBest',[this.record().balanceBest||0])})]},
