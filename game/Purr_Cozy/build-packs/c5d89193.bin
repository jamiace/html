 render_sky(){return[h('p',{class:'hint',text:this.t('skyHelp')}),this.button('starMemory',()=>{this.session.profile='memory';this.newCards()},false,'primary'),this.button('merchant',()=>this.launch('merchant'))]},
 render_inspiration(){const prompts=['idea0','idea1','idea2','idea3','idea4'];let seed=0;for(const ch of Life.today()+this.session.it.k)seed=(seed*31+ch.charCodeAt(0))>>>0;return[h('div',{class:'fp-inspiration',text:this.t(prompts[seed%prompts.length])}),this.button('memo',()=>this.launch('memo')),this.button('breathStart',()=>{this.session.profile='breath';this.refresh()})]},
 render_pet(){return[this.button('callCat',()=>this.callCat(),false,'primary'),this.button('petCare',()=>{UI.petTab='care';this.launch('pet')}),this.button('petTrain',()=>{UI.petTab='train';this.launch('pet')}),this.button('original',()=>this.native())]},
 nearest(it){const cv=Room.itemCanvas(it),x=it.x+cv.width/2,y=it.y+cv.height;return (Game.pets||[]).filter(p=>p.data&&!p.walking&&!p.jump&&!['eat','trick','hand','inbox','zoom','sleep'].includes(p.state)).sort((a,b)=>Math.hypot(a.x-x,a.y-y)-Math.hypot(b.x-x,b.y-y))[0]||null},
