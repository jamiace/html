 flipCard(i){if(!this.visible())return;const s=this.session;if(!s.cards||s.flipped.length>=2||s.flipped.includes(i)||s.matched.includes(i))return;s.flipped.push(i);if(s.flipped.length===2){s.moves++;const[a,b]=s.flipped;if(s.cards[a].pair===s.cards[b].pair){s.matched.push(a,b);s.flipped=[];if(s.matched.length===8){s.phase='won';this.best('cardBest',s.moves,true)}}else this.later(()=>{s.flipped=[];this.refresh()},850)}this.refresh()},
 makePuzzle(random=Math.random){const a=[1,2,3,4,5,6,7,8,0];let last=-1;for(let n=0;n<12;n++){const z=a.indexOf(0),next=[z-3,z+3,z%3?z-1:-1,z%3<2?z+1:-1].filter(i=>i>=0&&i<9&&i!==last),i=next[Math.floor(random()*next.length)];[a[z],a[i]]=[a[i],a[z]];last=z}if(a.every((v,i)=>v===(i+1)%9))[a[7],a[8]]=[a[8],a[7]];return a},
